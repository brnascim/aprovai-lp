PEXELS_API_KEY=
PIXABAY_API_KEY=
CONTENT_ENGINE_WORKDIR=/tmp/content-engine

# Opcional: se preenchido, a narração passa a usar ElevenLabs em vez do
# Edge-TTS gratuito (a não ser que o node do n8n passe voz_provider="edge"
# explicitamente). Pegue em https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_multilingual_v2
