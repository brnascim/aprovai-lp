{
  "name": "YT - Veo3 (Canal Dark Shorts - MoviAPI)",
  "nodes": [
    {
      "parameters": {
        "content": "## YT - Veo3 — Shorts automáticos (canal dark)\n\nReconstrução do fluxo do vídeo tutorial.\n\n**Como funciona:**\n1. MoviAPI (template `veo3short`) gera o Short com Veo3 — já devolve VÍDEO + ROTEIRO + TÍTULO prontos.\n2. Um Agente OpenAI reescreve o título no estilo viral (ex.: Zack D. Films).\n3. Upload direto no YouTube via API resumível (3 passos: CriaURL → Download → FinalizaUpload).\n\n⚙️ Preencha os PLACEHOLDER e ligue as credenciais (MoviAPI, OpenAI, YouTube OAuth2).",
        "height": 300,
        "width": 420,
        "color": 3
      },
      "id": "sticky-intro",
      "name": "Leia-me",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [-140, -60]
    },
    {
      "parameters": {},
      "id": "manual-trigger",
      "name": "When clicking 'Execute workflow'",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [-140, 300]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 8
            }
          ]
        }
      },
      "id": "schedule-trigger",
      "name": "Schedule Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [-140, 460]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "c1",
              "name": "moviapi_key",
              "value": "PLACEHOLDER_MOVIAPI_KEY",
              "type": "string"
            },
            {
              "id": "c2",
              "name": "email",
              "value": "seu-email@gmail.com",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "credenciais",
      "name": "Credenciais",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [120, 380]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://v1.moviapi.com/api/v1/video",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $('Credenciais').item.json.moviapi_key }}"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "template",
              "value": "veo3short"
            },
            {
              "name": "language",
              "value": "en"
            }
          ]
        },
        "options": {}
      },
      "id": "moviapi-start",
      "name": "MOVIAPI",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [360, 380]
    },
    {
      "parameters": {
        "amount": 120
      },
      "id": "wait1",
      "name": "Wait1",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [580, 380],
      "webhookId": "veo3-wait"
    },
    {
      "parameters": {
        "url": "=https://v1.moviapi.com/api/v1/video/{{ $('MOVIAPI').item.json.id }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $('Credenciais').item.json.moviapi_key }}"
            }
          ]
        },
        "options": {}
      },
      "id": "moviapi-status",
      "name": "MOVIAPI1",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [800, 380]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=You are a YouTube SEO and content creation expert.\n\nCreate a YouTube Shorts title in the exact style of Zack D. Films: short, curiosity-driven, no clickbait lies, optional emoji. Return ONLY the title.\n\nScript:\n{{ $json.script }}",
        "options": {}
      },
      "id": "titulo",
      "name": "Titulo",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.7,
      "position": [1040, 380]
    },
    {
      "parameters": {
        "model": {
          "__rl": true,
          "value": "gpt-4o-mini",
          "mode": "list"
        },
        "options": {}
      },
      "id": "openai-model",
      "name": "OpenAI Chat Model5",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.2,
      "position": [1040, 560],
      "credentials": {
        "openAiApi": {
          "id": "PLACEHOLDER_OPENAI_CRED",
          "name": "OpenAi account"
        }
      }
    },
    {
      "parameters": {
        "content": "### Sobe Youtube\nUpload resumível em 3 passos:\nCriaURL (inicia) → Download Video1 (baixa MP4) → FinalizaUpload (PUT do binário).",
        "height": 320,
        "width": 720,
        "color": 2
      },
      "id": "sticky-upload",
      "name": "Sobe Youtube",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [1300, 240]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://www.googleapis.com/upload/youtube/v3/videos?part=snippet,status&uploadType=resumable",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "youTubeOAuth2Api",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Upload-Content-Type",
              "value": "video/*"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"snippet\": {\n    \"title\": {{ JSON.stringify($('Titulo').item.json.output) }},\n    \"description\": {{ JSON.stringify($('MOVIAPI1').item.json.script) }},\n    \"categoryId\": \"27\"\n  },\n  \"status\": {\n    \"privacyStatus\": \"public\",\n    \"selfDeclaredMadeForKids\": false\n  }\n}",
        "options": {
          "response": {
            "response": {
              "fullResponse": true
            }
          }
        }
      },
      "id": "cria-url",
      "name": "CriaURL",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1360, 400],
      "credentials": {
        "youTubeOAuth2Api": {
          "id": "PLACEHOLDER_YOUTUBE_CRED",
          "name": "YouTube account"
        }
      }
    },
    {
      "parameters": {
        "url": "={{ $('MOVIAPI1').item.json.url }}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "file",
              "outputPropertyName": "data"
            }
          }
        }
      },
      "id": "download-video",
      "name": "Download Video1",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1600, 400]
    },
    {
      "parameters": {
        "method": "PUT",
        "url": "={{ $('CriaURL').item.json.headers.location }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "video/mp4"
            }
          ]
        },
        "sendBody": true,
        "contentType": "binaryData",
        "inputDataFieldName": "data",
        "options": {}
      },
      "id": "finaliza-upload",
      "name": "FinalizaUpload",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1840, 400]
    }
  ],
  "connections": {
    "When clicking 'Execute workflow'": {
      "main": [[{ "node": "Credenciais", "type": "main", "index": 0 }]]
    },
    "Schedule Trigger": {
      "main": [[{ "node": "Credenciais", "type": "main", "index": 0 }]]
    },
    "Credenciais": {
      "main": [[{ "node": "MOVIAPI", "type": "main", "index": 0 }]]
    },
    "MOVIAPI": {
      "main": [[{ "node": "Wait1", "type": "main", "index": 0 }]]
    },
    "Wait1": {
      "main": [[{ "node": "MOVIAPI1", "type": "main", "index": 0 }]]
    },
    "MOVIAPI1": {
      "main": [[{ "node": "Titulo", "type": "main", "index": 0 }]]
    },
    "OpenAI Chat Model5": {
      "ai_languageModel": [[{ "node": "Titulo", "type": "ai_languageModel", "index": 0 }]]
    },
    "Titulo": {
      "main": [[{ "node": "CriaURL", "type": "main", "index": 0 }]]
    },
    "CriaURL": {
      "main": [[{ "node": "Download Video1", "type": "main", "index": 0 }]]
    },
    "Download Video1": {
      "main": [[{ "node": "FinalizaUpload", "type": "main", "index": 0 }]]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {},
  "meta": {
    "templateCredsSetupCompleted": false
  },
  "tags": ["canal-dark", "veo3", "moviapi", "shorts"]
}
