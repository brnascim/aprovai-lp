# Aprovaí — Variáveis de Ambiente

## API Anthropic (App Next.js — assistant/)
ANTHROPIC_API_KEY=sk-ant-v7-...
ANTHROPIC_MODEL=claude-sonnet-4-6

## Gate de acesso do Motor (endpoint /api/otimizar e assistant) — ver aprovai/docs/07
# Segredo compartilhado entre Vercel e n8n que assina/valida o token de acesso.
ACCESS_TOKEN_SECRET=
# CSV de origens liberadas no CORS (default: domínios mentoriaaprovai.com.br).
ALLOWED_ORIGINS=https://mentoriaaprovai.com.br,https://www.mentoriaaprovai.com.br
# Rate-limit (defaults: 12 req / 60s). Upstash é opcional, mas recomendado em produção.
RATE_LIMIT_MAX=12
RATE_LIMIT_WINDOW_SEC=60
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# DEV ONLY — 'true' libera o endpoint sem token. NUNCA em produção.
ALLOW_UNVERIFIED_ACCESS=

## Analytics (PostHog — chave pública phc_...)
POSTHOG_KEY=phc_...

## n8n API (Cloud automation)
N8N_API_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
N8N_URL=https://n8n.mentoriaaprovai.com.br

## Stripe (Pagamento)
STRIPE_PUBLIC_KEY=pk_live_...
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

## SMTP / E-mail (n8n entrega)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu-email@gmail.com
SMTP_PASSWORD=seu-app-password

## App Next.js (assistant/)
NEXT_PUBLIC_API_URL=https://mentoriaaprovai.com.br/api
NEXT_PUBLIC_STRIPE_PUBLIC_KEY=pk_live_...

## Dados da aplicação
APP_NAME=Aprovaí
APP_URL=https://mentoriaaprovai.com.br
SUPPORT_EMAIL=contato@mentoriaaprovai.com.br

## Logging & Observabilidade (opcional)
LOG_LEVEL=info
# SENTRY_DSN=https://...
